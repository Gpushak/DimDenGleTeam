# Образец переменных окружения для docker-compose.
#   cp .env.example .env
# Значения ниже — по умолчанию; задавать нужно только то, что отличается.

# ── REST API ───────────────────────────────────────────────────────────
# Порт, на который пробрасывается API (контейнер всегда слушает 8000).
API_PORT=8000

# ── Весовой модуль (сервис scale-emulator) ─────────────────────────────
# SERIAL_PORT пустой → эмулятор генерирует тестовые веса (режим симуляции).
# Чтобы читать реальный Arduino, задайте путь к порту, например:
#   Linux/macOS:  SERIAL_PORT=/dev/ttyUSB0
#   Windows:     SERIAL_PORT=COM3
SERIAL_PORT=

# Устройство хоста, пробрасываемое в контейнер. Используется только
# вместе с SERIAL_PORT; раскомментируйте блок `devices:` в docker-compose.yml.
SERIAL_DEVICE=/dev/ttyUSB0

# Baud rate прошивки Arduino. Должен совпадать с shared/protocol.py.
SERIAL_BAUD=9600

# Как часто публиковать показание в POST /scale, секунды.
PUBLISH_INTERVAL=1.0

# Диапазон генерируемых весов в режиме симуляции, граммы.
SIM_MIN_WEIGHT=0
SIM_MAX_WEIGHT=2500

# ── Android (сборка APK) ───────────────────────────────────────────────
# Адрес сервера зашивается в приложение при сборке:
#   ./gradlew assembleDebug -PapiHost=192.168.1.50 -PapiPort=8000
# Для эмулятора Android используется 10.0.2.2 (хост-машина).
# Эти же значения читает android/app/build.gradle из переменных
# окружения API_HOST / API_PORT.
API_HOST=10.0.2.2
API_PORT_ANDROID=8000

# ── Десктопное приложение (запускается нативно, не в Docker) ───────────
# Адрес API, к которому подключается desktop/main.py.
# API_BASE_URL=http://127.0.0.1:8000
# Порт Arduino с весами; пусто — веса берутся из GET /scale.
# SERIAL_PORT=/dev/ttyUSB0