# Скопируйте этот файл в .env и при необходимости измените значения.
# docker-compose автоматически подхватывает .env из корня репозитория.

# Порт REST API на хосте (внутри контейнера всегда 8000)
API_PORT=8000

# Serial-порт весового модуля для сервиса scale-emulator (profile: scale)
SERIAL_DEVICE=/dev/ttyUSB0
SERIAL_PORT=/dev/ttyUSB0
