# Исключаем из контекста сборки всё, что не нужно образам.
#
# Контекст обоих образов — корень репозитория (api берёт server/ и shared/,
# эмулятор весов — firmware/), поэтому без этого файла в сборку ушли бы
# .git, android/ и все артефакты сборок.

.git
.gitignore
.idea
.vscode
*.iml

# Android: исходники в образ не попадают, APK собирается отдельно
android/

# Десктоп запускается нативно, в контейнер не копируется
desktop/

# Python
**/__pycache__/
**/*.py[cod]
.venv/
venv/

# Локальная БД и артефакты
**/*.db
server/data/

# Окружение
.env
.env.example

# Документация и конфиги, не нужные в образе
**/*.md
docker-compose.yml
README.md